#include "TraverseDirect.xcconfig"
// Separate scoped Developer ID composition for an eventual public feed.
CODE_SIGN_ENTITLEMENTS = $(SRCROOT)/Distribution/TraverseUpdater.entitlements
INFOPLIST_FILE = $(SRCROOT)/.build/traverse-release/tooling/public-updater/TraverseInfo.plist
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) MAC_EXPLORER_DISTRIBUTION TRAVERSE_PUBLIC_UPDATER
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/.build/traverse-release/tooling/sparkle-2.10.0/unpacked/Sparkle.xcframework/macos-arm64_x86_64
