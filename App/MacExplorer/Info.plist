<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleName</key><string>Traverse</string>
    <key>CFBundleDisplayName</key><string>Traverse Development</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>TraverseApplication</string>
    <key>MacExplorerDistributionChannel</key><string>development</string>
    <key>MacExplorerDevelopmentStateRoot</key><string>$(SRCROOT)/.build/runtime</string>
    <key>MacExplorerDevelopmentCacheRoot</key><string>$(SRCROOT)/.build/runtime-cache</string>
    <key>MacExplorerCopyPreviewInternalVolume</key><string>$(MAC_EXPLORER_COPY_PREVIEW_INTERNAL_VOLUME)</string>
    <key>MacExplorerCopyPreviewWorkspaceVolume</key><string>$(MAC_EXPLORER_COPY_PREVIEW_WORKSPACE_VOLUME)</string>
    <key>MacExplorerCopyPreviewHistoryVolume</key><string>$(MAC_EXPLORER_COPY_PREVIEW_HISTORY_VOLUME)</string>
    <key>MacExplorerCopyPreviewQualified</key><string>$(MAC_EXPLORER_COPY_PREVIEW_QUALIFIED)</string>
    <key>NSDesktopFolderUsageDescription</key><string>Browse Desktop folders when you choose them in Traverse.</string>
    <key>NSDocumentsFolderUsageDescription</key><string>Browse Documents folders when you choose them in Traverse.</string>
    <key>NSDownloadsFolderUsageDescription</key><string>Browse Downloads folders when you choose them in Traverse.</string>
    <key>NSNetworkVolumesUsageDescription</key><string>Browse mounted network volumes when you choose them in Traverse.</string>
    <key>NSRemovableVolumesUsageDescription</key><string>Browse removable volumes when you choose them in Traverse.</string>
    <key>NSLocalNetworkUsageDescription</key><string>Connect to SMB and SFTP servers you choose on your local network.</string>
</dict>
</plist>
