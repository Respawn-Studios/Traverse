+    fn access(self)->u32{match self{Self::Directory=>DIRECTORY_ACCESS,Self::ActionDirectory=>DIRECTORY_ACTION_ACCESS,
+        Self::File=>FILE_ACCESS,Self::Probe|Self::Post|Self::PostDirectory=>PROBE_ACCESS}}
+    fn options(self)->u32{match self{Self::Directory|Self::ActionDirectory|Self::PostDirectory=>DIRECTORY_OPTIONS,
+        Self::File=>FILE_OPTIONS,Self::Probe|Self::Post=>PROBE_OPTIONS}}
